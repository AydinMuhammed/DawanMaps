<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" /> <!-- Autorise les connexions Internet (on en a besoin pour les appels API) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- Autorise la vérification de l'état du réseau (utile pour le mode hors connexion via le cache)-->


    <!-- DawanMapsApp  s'exécute au démarrage de l'app pour configurer osmdroid.-->
    <application
        android:name=".DawanMapsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DawanMaps">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>